# Server-side only. Never prefix with NEXT_PUBLIC_.
OPENROUTER_API_KEY=
# Any OpenRouter model that supports tool calling.
OPENROUTER_MODEL=anthropic/claude-haiku-5.5

# Spend cap: the chat goes into fallback mode once today's spend reaches it.
DAILY_BUDGET_EUR=1
EUR_TO_USD=1.15

# Per-visitor limits (per IP).
RATE_LIMIT_PER_10_MIN=15
RATE_LIMIT_PER_DAY=60

# Optional but recommended in production: shared counters across serverless
# instances (Upstash Redis REST). Without them, counters live in memory.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Public URL, for metadata.
NEXT_PUBLIC_SITE_URL=https://www.julesmoreau.eu
